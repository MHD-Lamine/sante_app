# === 🔐 Clés secrètes (OBLIGATOIRES) — générer avec :
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me
JWT_SECRET_KEY=change_me_aussi

# === 🗃️ Connexion PostgreSQL (Docker)
# Le mot de passe doit correspondre à POSTGRES_PASSWORD (docker-compose)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/suivi_sante

# === 🛠️ Options Flask
FLASK_APP=run.py
# Mettre true uniquement en développement
FLASK_DEBUG=false
